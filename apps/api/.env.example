# Copy to .env for local development
# Note: tenant tables use `FORCE ROW LEVEL SECURITY`, so RLS applies even to the
# table-owning role below (Postgres normally exempts owners from RLS - FORCE closes
# that gap without needing a second, separate low-privilege DB connection).
# In production, use a role that is NOT superuser and does NOT have BYPASSRLS.
DATABASE_URL="postgresql://clinic_crm:clinic_crm@localhost:5432/clinic_crm?schema=public"

# Narrow, BYPASSRLS role used ONLY by AuthService for pre-authentication
# lookups (login/magic-link by email, registration) where an
# organization_id isn't known yet. See prisma/roles.sql for the exact
# grants - it has no access at all to contacts/appointments/audit_log.
AUTH_DATABASE_URL="postgresql://clinic_crm_auth:clinic_crm_auth@localhost:5432/clinic_crm?schema=public"

JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_EXPIRES_IN="8h"

REDIS_URL="redis://localhost:6379"

PORT=3001

# AES key (32 bytes, base64) used to encrypt 2FA secrets at rest
TWO_FACTOR_ENCRYPTION_KEY="change-me-32-bytes-base64-encoded=="
